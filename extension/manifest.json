{
  "manifest_version": 3,
  "name": "Dropyhub HRMS - Activity & Presence Companion",
  "version": "1.0.0",
  "description": "Background activity and idle presence tracker for Dropyhub HRMS",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "idle",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dropyhub Activity Tracker"
  }
}
